{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatHarbor",
  "version": "0.1.0",
  "identifier": "org.chatharbor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ChatHarbor", "width": 1280, "height": 840, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'" }
  },
  "bundle": { "active": false }
}
